---
import SignupForm from "../components/SignupForm";
import UserGreeting from "../components/UserGreeting";
import SyllabusAccordion from "../components/SyllabusAccordion.astro";
import syllabusData from "../data/syllabus.json";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Signup form (hides when logged in) -->
  <SignupForm client:load />

  <!-- Greeting (hides when not logged in) -->
  <UserGreeting client:load />

  <!-- Accordions for each stream (shown when logged in to matching stream) -->
  {
    ["Science", "Commerce", "Arts"].map((stream) => (
      <div id={`accordion-${stream}`} class="hidden">
        <div class="mx-auto max-w-4xl p-4">
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <h2 class="card-title mb-6">Your {stream} Syllabus</h2>
              <SyllabusAccordion
                client:load
                subjects={[
                  ...(syllabusData["All"]?.subjects || []),
                  ...(syllabusData[stream as keyof typeof syllabusData]
                    ?.subjects || []),
                ]}
              />
            </div>
          </div>
        </div>
      </div>
    ))
  }

  <script>
    function updateDashboard() {
      // Hide all accordions
      document.getElementById("accordion-Science")?.classList.add("hidden");
      document.getElementById("accordion-Commerce")?.classList.add("hidden");
      document.getElementById("accordion-Arts")?.classList.add("hidden");

      try {
        const userStr = localStorage.getItem("sscprep_user");
        if (userStr) {
          const user = JSON.parse(userStr);
          const accordion = document.getElementById(`accordion-${user.stream}`);
          if (accordion) {
            accordion.classList.remove("hidden");
          }
        }
      } catch (e) {
        // Error parsing localStorage
      }
    }

    // Initial check
    updateDashboard();

    // Watch for storage changes
    window.addEventListener("storage", updateDashboard);

    // Also watch for changes from same tab
    const originalSetItem = localStorage.setItem;
    localStorage.setItem = function (key, value) {
      originalSetItem.apply(this, arguments);
      if (key === "sscprep_user") {
        setTimeout(updateDashboard, 0);
      }
    };
  </script>
</Layout>
