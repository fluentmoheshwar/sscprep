---
import SyllabusAccordion from "../components/SyllabusAccordion.astro";
import syllabusData from "../data/syllabus.json";
import Layout from "../layouts/Layout.astro";

const { stream = "Commerce" } = Astro.params;
const currentStream = syllabusData[stream as keyof typeof syllabusData];
---

<Layout>
  <h1 class="p-5 text-xl">Welcome to SSCPrep!</h1>
  <h2 class="pl-5">
    Your one-stop destination for comprehensive SSC exam preparation.
  </h2>

  <section class="p-6">
    <h2 class="mb-4 text-2xl font-bold">{currentStream.stream} Stream</h2>
    <SyllabusAccordion subjects={currentStream.subjects} />
  </section>

  <p class="p-5">Please choose your stream:</p>
  <div class="flex flex-col gap-4 p-5">
    <a
      href="/science"
      class="rounded bg-blue-500 px-4 py-2 text-white transition hover:bg-blue-600"
      >Science</a
    >
    <a
      href="/commerce"
      class="rounded bg-green-500 px-4 py-2 text-white transition hover:bg-green-600"
      >Commerce (Business Studies)</a
    >
    <a
      href="/arts"
      class="rounded bg-purple-500 px-4 py-2 text-white transition hover:bg-purple-600"
      >Arts (Humanities)</a
    >
  </div>
</Layout>
